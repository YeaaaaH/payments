# Local development config template. Copy to .env and fill in; .env is git-ignored.

## PostgreSQL (docker compose exposes it on 5432)
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=password

## JWT
SECRET=
# token lifetime in ms
EXPIRE_TIME=600000

## App
APP_TIMEZONE=Europe/Kyiv
APP_BASE_URL=http://localhost:8080

## Auth (docs/AUTH-PLAN.md)
# owner: may sign up without an invite and create invites
BOOTSTRAP_EMAIL=
# from @BotFather
TELEGRAM_BOT_TOKEN=
# Google Cloud OAuth client (dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
